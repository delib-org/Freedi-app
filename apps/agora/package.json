{
	"name": "@freedi/agora",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"env:dev": "cd ../.. && npm run env:dev",
		"dev": "npm run env:dev && vite --port 3009",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview --port 3009",
		"typecheck": "tsc --noEmit",
		"typecheck:scripts": "tsc --noEmit --strict --skipLibCheck --module esnext --moduleResolution bundler --target es2022 --lib es2022,dom scripts/fastlane.ts scripts/lib/fastlane.ts scripts/board-shots.ts",
		"lint": "eslint \"src/**/*.ts\"",
		"check-all": "npm run lint && npm run typecheck && npm run typecheck:scripts && npm test && npm run build && npm run contrast && npm run typesize",
		"test": "vitest run",
		"test:watch": "vitest",
		"seed": "npx tsx scripts/seed.ts",
		"seed:clear": "npx tsx scripts/seed.ts --clear",
		"fast": "npx tsx scripts/fastlane.ts",
		"preflight": "node scripts/lib/preflight.mjs",
		"contrast": "node scripts/contrast-audit.mjs",
		"typesize": "node scripts/type-audit.mjs"
	},
	"dependencies": {
		"@fontsource/alef": "^5.3.0",
		"@fontsource/assistant": "^5.3.0",
		"@freedi/engagement-core": "file:../../packages/engagement-core",
		"@freedi/shared-types": "file:../../packages/shared-types",
		"firebase": "^11.0.2",
		"mithril": "^2.2.8",
		"qrcode": "^1.5.4",
		"valibot": "^1.0.0-rc.1"
	},
	"devDependencies": {
		"@types/mithril": "^2.2.7",
		"@types/qrcode": "^1.5.6",
		"firebase-admin": "^13.6.0",
		"sass": "^1.94.2",
		"tsx": "^4.19.0",
		"typescript": "^5.7.3",
		"vite": "^6.0.7",
		"vite-plugin-pwa": "^0.21.1",
		"vitest": "^4.0.18"
	}
}
