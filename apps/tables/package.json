{
  "name": "@freedi/tables",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "env:dev": "cd ../.. && npm run env:dev",
    "dev": "npm run env:dev && vite --port 3037",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3037",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "check-all": "npm run lint && npm run typecheck && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@freedi/shared-types": "file:../../packages/shared-types",
    "@freedi/table-assignment-client": "file:../../packages/table-assignment-client",
    "@sentry/browser": "^9.42.1",
    "firebase": "^12.18.0",
    "mithril": "^2.2.8",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/mithril": "^2.2.7",
    "@types/qrcode": "^1.5.6",
    "jsdom": "^29.1.1",
    "sass": "^1.94.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^4.0.18"
  }
}
