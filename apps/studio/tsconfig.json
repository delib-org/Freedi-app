{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    // Unused locals are enforced by ESLint (@typescript-eslint/no-unused-vars) so
    // that unused imports inside @freedi/shared-i18n/react (compiled from source
    // via the alias) do not fail Studio's tsc run.
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@freedi/shared-i18n": ["../../packages/shared-i18n/src/index.ts"],
      "@freedi/shared-i18n/*": ["../../packages/shared-i18n/src/*"],
      "@freedi/shared-utils": ["../../packages/shared-utils/src"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
