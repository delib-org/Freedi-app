@@ -0,0 +1,160 @@
+import type {
+	ThemeAbsorptionInput,
+	ThemeMergeGroup,
+	ThemeOption,
+} from '../../services/integration-ai-service';
+
+/**
+ * Plans which theme headings to merge: propose permissively, then verify.
+ *
+ * Why two stages. Measured on the 8 benchmark end states
+ * (`scientific-research/2026-10-24-merge-judge-fragmentation/`), the single
+ * heading-only call refused 24 of 27 pairs of headings that share a true topic,
+ * and 25 of the 27 involve a heading holding a single synthesis — a heading that
+ * exists only because the first idea to arrive had nowhere to go. Telling the
+ * judge how many ideas each heading holds fixes the refusals but admits wrong
+ * merges; asking a second question that SEES the ideas removes most of those.
+ *
+ *   1. Three proposals, the headings in a different order each time. A pair is
+ *      kept only when two of the three put it together (order effects and
+ *      sampling noise are what made single calls disagree).
+ *   2. A group may hold at most one established heading. Two well-populated
+ *      headings merging is how a catch-all forms; small headings joining one
+ *      established heading is the case the data supports. The established one
+ *      survives, so the heading readers have seen stays.
+ *   3. Each small heading is checked against the survivor with both headings'
+ *      ideas in view (`verifyAbsorption`). Fail-closed.
+ *
+ * Pure of Firestore: the judge calls are injected so this can be tested alone.
+ */
+
+/** A heading holding at most this many ideas is "small" (one synthesis, or a pair). */
+export const SMALL_THEME_MAX_IDEAS = 2;
+
+/** Independent proposals per sweep, each with the headings in a different order. */
+export const MERGE_PROPOSAL_VOTES = 3;
+
+/** Proposals that must put a pair together for it to be kept. */
+export const MERGE_VOTES_REQUIRED = 2;
+
+/**
+ * Deterministic shuffle: a plain LCG (Numerical Recipes constants), not
+ * security-relevant. Modulus 2^32 with a 1.6M multiplier keeps every product
+ * under 2^53, so the arithmetic stays exact in a JS number.
+ */
+const SHUFFLE_MODULUS = 4294967296;
+const SHUFFLE_MULTIPLIER = 1664525;
+const SHUFFLE_INCREMENT = 1013904223;
+const SHUFFLE_SEED_SPREAD = 40503;
+
+export interface PlannerTheme extends ThemeOption {
+	ideaCount: number;
+}
+
+export interface MergePlannerDeps {
+	propose: (input: {
+		themes: ThemeOption[];
+		questionContext: string;
+	}) => Promise<ThemeMergeGroup[]>;
+	verifyAbsorption: (input: ThemeAbsorptionInput) => Promise<boolean>;
+	/** Titles of the ideas under a heading; called only for headings in a candidate group. */
+	loadContents: (themeId: string) => Promise<string[]>;
+}
+
+/** Same input, same order — so a replay or a test is reproducible. */
+export function shuffledForVote<T>(list: T[], vote: number): T[] {
+	const out = [...list];
+	let x = (vote * SHUFFLE_SEED_SPREAD) % SHUFFLE_MODULUS;
+	for (let i = out.length - 1; i > 0; i--) {
+		x = (x * SHUFFLE_MULTIPLIER + SHUFFLE_INCREMENT) % SHUFFLE_MODULUS;
+		const j = x % (i + 1);
+		[out[i], out[j]] = [out[j], out[i]];
+	}
+
+	return out;
+}
+
+function pairKey(a: string, b: string): string {
+	return a < b ? `${a}|${b}` : `${b}|${a}`;
+}
+
+/** Connected components of the pairs that reached the vote threshold. */
+function agreedComponents(themes: PlannerTheme[], tally: Map<string, number>): string[][] {
+	const parent = new Map<string, string>();
+	const find = (x: string): string => {
+		let root = x;
+		while ((parent.get(root) ?? root) !== root) root = parent.get(root) as string;
+
+		return root;
+	};
+	for (const [key, votes] of tally) {
+		if (votes < MERGE_VOTES_REQUIRED) continue;
+		const [a, b] = key.split('|');
+		parent.set(find(a), find(b));
+	}
+	const components = new Map<string, string[]>();
+	for (const t of themes) {
+		const root = find(t.id);
+		components.set(root, [...(components.get(root) ?? []), t.id]);
+	}
+
+	return [...components.values()].filter((ids) => ids.length > 1);
+}
+
+export async function planThemeMerges(
+	themes: PlannerTheme[],
+	questionContext: string,
+	deps: MergePlannerDeps,
+): Promise<ThemeMergeGroup[]> {
+	const tally = new Map<string, number>();
+	for (let vote = 0; vote < MERGE_PROPOSAL_VOTES; vote++) {
+		const ordered = vote === 0 ? themes : shuffledForVote(themes, vote);
+		const groups = await deps.propose({ themes: ordered, questionContext });
+		const counted = new Set<string>();
+		for (const group of groups) {
+			for (let i = 0; i < group.ids.length; i++) {
+				for (let j = i + 1; j < group.ids.length; j++) {
+					counted.add(pairKey(group.ids[i], group.ids[j]));
+				}
+			}
+		}
+		for (const key of counted) tally.set(key, (tally.get(key) ?? 0) + 1);
+	}
+
+	const byId = new Map(themes.map((t) => [t.id, t]));
+	const rank = new Map(themes.map((t, i) => [t.id, i]));
+	const planned: ThemeMergeGroup[] = [];
+
+	for (const ids of agreedComponents(themes, tally)) {
+		const members = ids
+			.map((id) => byId.get(id))
+			.filter((t): t is PlannerTheme => Boolean(t))
+			.sort((a, b) => b.ideaCount - a.ideaCount || (rank.get(a.id) ?? 0) - (rank.get(b.id) ?? 0));
+		const established = members.filter((t) => t.ideaCount > SMALL_THEME_MAX_IDEAS);
+		if (established.length > 1) continue;
+
+		const [survivor, ...donors] = members;
+		const survivorContents = await deps.loadContents(survivor.id);
+		const accepted: string[] = [survivor.id];
+		for (const donor of donors) {
+			const fits = await deps.verifyAbsorption({
+				donor: {
+					title: donor.title,
+					description: donor.description,
+					contents: await deps.loadContents(donor.id),
+				},
+				survivor: {
+					title: survivor.title,
+					description: survivor.description,
+					contents: survivorContents,
+					ideaCount: survivor.ideaCount,
+				},
+				questionContext,
+			});
+			if (fits) accepted.push(donor.id);
+		}
+		if (accepted.length > 1) planned.push({ ids: accepted, title: survivor.title });
+	}
+
+	return planned;
+}
