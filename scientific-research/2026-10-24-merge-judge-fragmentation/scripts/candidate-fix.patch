+		const groups = await planThemeMerges(themes, 'q', d);
+
+		expect(groups).toEqual([{ ids: ['big', 'small'], title: 'Heading big' }]);
+	});
+
+	it('drops a pair only one proposal suggested', async () => {
+		const d = deps({ propose: proposeOnVotes([1], { ids: ['small', 'big'], title: 'x' }) });
+
+		expect(await planThemeMerges(themes, 'q', d)).toEqual([]);
+		expect(d.verifyAbsorption).not.toHaveBeenCalled();
+	});
+
+	it('refuses to merge two established headings', async () => {
+		const d = deps({ propose: proposeOnVotes([0, 1, 2], { ids: ['big', 'other'], title: 'x' }) });
+
+		expect(await planThemeMerges(themes, 'q', d)).toEqual([]);
+		expect(d.verifyAbsorption).not.toHaveBeenCalled();
+	});
+
+	it('lets several small headings join one established heading', async () => {
+		const list = [theme('big', BIG), theme('s1', 1), theme('s2', 2)];
+		const d = deps({
+			propose: proposeOnVotes([0, 1, 2], { ids: ['s1', 'big', 's2'], title: 'x' }),
+		});
+
+		const groups = await planThemeMerges(list, 'q', d);
+
+		expect(groups).toHaveLength(1);
+		expect(groups[0].ids).toEqual(['big', 's2', 's1']);
+	});
+});
+
+describe('planThemeMerges — verification', () => {
+	const themes = [theme('big', BIG), theme('small', 1), theme('other', BIG)];
+	const agreed = (): MergePlannerDeps['propose'] =>
+		proposeOnVotes([0, 1, 2], { ids: ['small', 'big'], title: 'x' });
+
+	it('shows the verifier the ideas of both headings', async () => {
+		const d = deps({ propose: agreed() });
+
+		await planThemeMerges(themes, 'q', d);
+
+		const input = (d.verifyAbsorption as jest.Mock).mock.calls[0][0];
+		expect(input.donor.contents).toEqual(['idea of small']);
+		expect(input.survivor.contents).toEqual(['idea of big']);
+		expect(input.survivor.ideaCount).toBe(BIG);
+		expect(input.questionContext).toBe('q');
+	});
+
+	it('drops a group the verifier rejects', async () => {
+		const d = deps({ propose: agreed(), verifyAbsorption: jest.fn(async () => false) });
+
+		expect(await planThemeMerges(themes, 'q', d)).toEqual([]);
+	});
+
+	it('keeps only the donors the verifier approves', async () => {
+		const list = [theme('big', BIG), theme('s1', 1), theme('s2', 1)];
+		const d = deps({
+			propose: proposeOnVotes([0, 1, 2], { ids: ['big', 's1', 's2'], title: 'x' }),
+			verifyAbsorption: jest.fn(async ({ donor }) => donor.title === 'Heading s1'),
+		});
+
+		const groups = await planThemeMerges(list, 'q', d);
+
+		expect(groups[0].ids).toEqual(['big', 's1']);
+	});
+});
