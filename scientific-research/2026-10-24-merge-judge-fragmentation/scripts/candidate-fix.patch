+	it('is deterministic and does not mutate its input', () => {
+		const list = ['a', 'b', 'c', 'd', 'e'];
+
+		expect(shuffledForVote(list, 1)).toEqual(shuffledForVote(list, 1));
+		expect(list).toEqual(['a', 'b', 'c', 'd', 'e']);
+		expect([...shuffledForVote(list, 2)].sort()).toEqual(list);
+	});
+
+	it('changes the order for different votes', () => {
+		const list = Array.from({ length: 12 }, (_, i) => String(i));
+
+		expect(shuffledForVote(list, 1)).not.toEqual(shuffledForVote(list, 2));
+	});
