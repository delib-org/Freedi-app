+	id,
+	title: `Heading ${id}`,
+	ideaCount,
+});
+
+const BIG = SMALL_THEME_MAX_IDEAS + 3;
+
+function deps(overrides: Partial<MergePlannerDeps> = {}): MergePlannerDeps {
+	return {
+		propose: jest.fn(async () => [] as ThemeMergeGroup[]),
+		verifyAbsorption: jest.fn(async () => true),
