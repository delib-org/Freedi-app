+
+/** The judge answers the same group on the listed votes only (0-based call order). */
+function proposeOnVotes(votes: number[], group: ThemeMergeGroup): MergePlannerDeps['propose'] {
+	let call = -1;
+
+	return jest.fn(async () => {
+		call++;
+
+		return votes.includes(call) ? [group] : [];
+	});
+}
+
