{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"target": "ES2020",
		"useDefineForClassFields": true,
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"skipLibCheck": true,

		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"noEmit": true,
		"jsx": "react-jsx",
		"resolveJsonModule": true,

		/* Paths configuration */
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"],
			"@freedi/shared-i18n": ["packages/shared-i18n/src/index.ts"],
			"@freedi/shared-i18n/*": ["packages/shared-i18n/src/*"],
			"@freedi/shared-utils": ["packages/shared-utils/src/index.ts"],
			"@freedi/shared-utils/*": ["packages/shared-utils/src/*"]
		}
	},
	// functions/src is deliberately NOT here. It is typechecked by
	// functions/tsconfig.json, which sets "strict": true — this config does not,
	// and without strictNullChecks TypeScript cannot narrow a discriminated union
	// on its boolean tag, so correct code like `if (!result.ok) result.reason`
	// fails here while compiling cleanly under the config that actually governs
	// it. Run `npm run typecheck:functions` (included in check-all) for that tree.
	"include": ["src", "packages/shared-i18n/src", "packages/shared-utils/src"],
	"exclude": ["node_modules", "node_modules/delib-npm/src"],
	"references": [{
		"path": "./tsconfig.node.json"
	}]
}